 addUserKnob {22 Undistort -STARTLINE T "a = nuke.thisNode()\na\['preferences_label_und_dis'].setValue(0)\na\['disable_1'].setValue(0)"}
 addUserKnob {7 preferences_label_und_dis l INVISIBLE +INVISIBLE}
 preferences_label_und_dis 1
 addUserKnob {22 label_turn_off l "Turn off" -STARTLINE T "a = nuke.thisNode()\na\['disable_1'].setValue(1)"}
 addUserKnob {41 disable_1 l INVISIBLE -STARTLINE +INVISIBLE T STMap.disable}
 addUserKnob {26 ""}
 addUserKnob {26 label_focal_length l "" -STARTLINE T "Focal Length:"}
 addUserKnob {22 label_28mm l 28mm T "a = nuke.thisNode()\na\['preferences_label_lenseswitch'].setValue(0)" +STARTLINE}
